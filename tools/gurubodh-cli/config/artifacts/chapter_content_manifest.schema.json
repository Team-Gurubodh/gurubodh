{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurubodh.local/schemas/chapter_content_manifest.schema.json",
  "title": "Gurubodh prepared chapter content manifest",
  "type": "object",
  "required": ["schema_version", "identity_contract_version", "subject", "chapters"],
  "properties": {
    "schema_version": { "const": 1 },
    "identity_contract_version": { "const": 1 },
    "subject": {
      "type": "object",
      "required": ["category_code", "subject_code", "language"],
      "properties": {
        "category_code": { "type": "string", "pattern": "^CAT[0-9]{3}$" },
        "subject_code": { "type": "string", "pattern": "^SUB[0-9]{3}$" },
        "language": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["generated_chapter_number", "content_key", "normalized_content_sha256", "metadata_artifact", "text_artifact"],
        "properties": {
          "generated_chapter_number": { "type": "string", "pattern": "^[0-9]{3}$" },
          "content_key": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-5[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
          "normalized_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "metadata_artifact": { "type": "object" },
          "text_artifact": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
