{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurubodh.local/schemas/artifacts/semantic_chunks.schema.json",
  "title": "Gurubodh candidate semantic chunks artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "files", "source_references", "chunking", "token_counting", "chunks", "diagnostics"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_code", "subject_code", "title_slug", "chapter_number", "version", "language"],
      "properties": {
        "category_code": { "type": "string", "pattern": "^CAT[0-9]{3}$" },
        "subject_code": { "type": "string", "pattern": "^SUB[0-9]{3}$" },
        "title_slug": { "type": "string" },
        "chapter_number": { "type": "string", "pattern": "^[0-9]{3}$" },
        "version": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_filename", "source_text_filename", "source_metadata_filename"],
      "properties": {
        "chunk_filename": { "type": "string", "pattern": "\\.chunks\\.json$" },
        "source_text_filename": { "type": "string", "pattern": "\\.txt$" },
        "source_metadata_filename": { "type": "string", "pattern": "\\.json$" }
      }
    },
    "source_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_manifest", "content_identity", "chapter_text_artifact", "chapter_metadata_artifact", "source_text_checksum"],
      "properties": {
        "candidate_manifest": { "$ref": "#/$defs/manifestBinding" },
        "content_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_key", "normalized_content_sha256", "identity_contract_version"],
          "properties": {
            "content_key": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
            "normalized_content_sha256": { "$ref": "#/$defs/sha256" },
            "identity_contract_version": { "const": 1 }
          }
        },
        "chapter_text_artifact": { "type": "object" },
        "chapter_metadata_artifact": { "type": "object" },
        "source_text_checksum": { "type": "object" }
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "model_revision", "strategy_version", "threshold_percentile", "min_chars", "window_size", "batch_size", "normalize_contextual_vectors", "device", "chunking_config_key", "breakpoint_threshold"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "model_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "strategy_version": { "type": "string" },
        "threshold_percentile": { "type": "number" },
        "min_chars": { "type": "integer", "minimum": 0 },
        "window_size": { "type": "integer", "minimum": 1 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "normalize_contextual_vectors": { "type": "boolean" },
        "device": { "type": ["string", "null"] },
        "chunking_config_key": { "$ref": "#/$defs/sha256" },
        "breakpoint_threshold": { "type": ["number", "null"] }
      }
    },
    "token_counting": { "type": "object" },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_index", "text", "sentence_count", "character_count", "estimated_token_count", "sentence_range", "character_span", "chunk_text_sha256"],
        "properties": {
          "chunk_index": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sentence_count": { "type": "integer", "minimum": 1 },
          "character_count": { "type": "integer", "minimum": 1 },
          "estimated_token_count": { "type": "integer", "minimum": 0 },
          "sentence_range": { "type": "object" },
          "character_span": { "type": "object" },
          "chunk_text_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "diagnostics": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256"],
      "properties": {
        "reference": { "type": "object" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
