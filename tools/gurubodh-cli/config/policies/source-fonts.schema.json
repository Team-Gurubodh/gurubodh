{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared source-font approvals",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approved_unicode_font_families"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approved_unicode_font_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {"pattern": "\\S"},
          {"not": {"pattern": "[\\*\\?\\[\\]]"}}
        ],
        "description": "Complete family name; case and whitespace are normalized. Wildcards and legacy-family conflicts are forbidden."
      }
    }
  }
}
