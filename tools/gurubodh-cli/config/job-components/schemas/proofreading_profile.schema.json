{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurubodh.local/schemas/job-components/proofreading_profile.schema.json",
  "title": "Gurubodh complete proofreading profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_schema_version",
    "profile_id",
    "proofreading"
  ],
  "properties": {
    "component_schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*-v[1-9][0-9]*(?![\\s\\S])"
    },
    "proofreading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provider",
        "model",
        "max_output_tokens",
        "max_input_characters",
        "max_retries",
        "initial_retry_delay_seconds",
        "max_retry_delay_seconds",
        "min_request_interval_seconds",
        "max_requests_per_minute",
        "max_estimated_input_tokens_per_minute",
        "request_timeout_seconds",
        "request_progress_interval_seconds",
        "unavailable_max_retries",
        "unavailable_first_retry_delay_seconds",
        "unavailable_second_retry_delay_seconds",
        "unavailable_cooldown_seconds",
        "continue_on_error"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "provider": {
          "type": "string",
          "const": "google-ai-studio"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_characters": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 1
        },
        "initial_retry_delay_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_retry_delay_seconds": {
          "type": "number",
          "minimum": 0
        },
        "min_request_interval_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_requests_per_minute": {
          "type": "integer",
          "minimum": 1
        },
        "max_estimated_input_tokens_per_minute": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "request_progress_interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unavailable_max_retries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "unavailable_first_retry_delay_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unavailable_second_retry_delay_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unavailable_cooldown_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "continue_on_error": {
          "const": false
        }
      }
    }
  }
}
