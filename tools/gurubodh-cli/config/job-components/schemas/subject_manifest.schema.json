{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurubodh.local/schemas/job-components/subject_manifest.schema.json",
  "title": "Gurubodh subject manifest and locale editions",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_schema_version", "manifest_id", "identity", "artifact_root", "editions"],
  "properties": {
    "component_schema_version": { "const": "1.0.0" },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*(?![\\s\\S])"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_code", "subject_code", "title_slug"],
      "properties": {
        "category_code": { "type": "string", "pattern": "^CAT[0-9]{3}(?![\\s\\S])" },
        "subject_code": { "type": "string", "pattern": "^SUB[0-9]{3}(?![\\s\\S])" },
        "title_slug": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?![\\s\\S])" }
      }
    },
    "artifact_root": { "$ref": "#/$defs/safe_relative_path" },
    "editions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hi-IN": { "$ref": "#/$defs/edition" },
        "mr-IN": { "$ref": "#/$defs/edition" }
      }
    },
    "profile_overrides": { "$ref": "#/$defs/profile_overrides" }
  },
  "$defs": {
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\:\\x00-\\x1f\\x7f${}]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\:\\x00-\\x1f\\x7f${}]+)*(?![\\s\\S])"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*-v[1-9][0-9]*(?![\\s\\S])"
    },
    "profile_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proofreading": { "$ref": "#/$defs/profile_id" },
        "chunking": { "$ref": "#/$defs/profile_id" }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "source_document", "chapter_split"],
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "subversion"],
          "properties": {
            "version": { "type": "string", "pattern": "^[0-9]{2}(?![\\s\\S])" },
            "subversion": { "type": "string", "pattern": "^[0-9]{2}(?![\\s\\S])" }
          }
        },
        "source_document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative_path", "font_encoding", "file_format"],
          "properties": {
            "relative_path": { "$ref": "#/$defs/safe_relative_path" },
            "font_encoding": { "enum": ["aps", "unicode"] },
            "file_format": { "const": "docx" }
          }
        },
        "chapter_split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "pattern_type": { "enum": ["literal", "regex"] },
            "pattern": { "type": "string", "minLength": 1 },
            "flags": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["IGNORECASE", "MULTILINE", "DOTALL", "VERBOSE"] }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["pattern_type", "pattern"] },
              "else": {
                "allOf": [
                  { "not": { "required": ["pattern_type"] } },
                  { "not": { "required": ["pattern"] } },
                  { "not": { "required": ["flags"] } }
                ]
              }
            },
            {
              "if": { "properties": { "pattern_type": { "const": "regex" } }, "required": ["pattern_type"] },
              "then": { "required": ["flags"] }
            },
            {
              "if": { "properties": { "pattern_type": { "const": "literal" } }, "required": ["pattern_type"] },
              "then": { "not": { "required": ["flags"] } }
            }
          ]
        },
        "profile_overrides": { "$ref": "#/$defs/profile_overrides" }
      }
    }
  }
}
